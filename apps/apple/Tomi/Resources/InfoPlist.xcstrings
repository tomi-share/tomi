    "NSFaceIDUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomi fragt nach Face ID, bevor ein verborgener Eintrag angezeigt, kopiert oder geteilt wird."
