    "onboarding_pin_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte Tomi gedrückt und wähle dann „Anheften“. Tomi bleibt dann ganz vorne, immer an derselben Stelle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold Tomi, then choose “Pin”. It will stay first, always in the same place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén presionado Tomi y elige “Fijar”. Quedará en primer lugar, siempre en el mismo sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuie longuement sur Tomi, puis choisis « Épingler ». Il restera en premier, toujours à la même place."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomi को दबाकर रखें, फिर “पिन करें” चुनें। यह हमेशा सबसे पहले, एक ही जगह पर रहेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuh lama Tomi, lalu pilih “Sematkan”. Tomi akan selalu berada di urutan pertama, di tempat yang sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto su Tomi, poi scegli “Fissa”. Resterà primo, sempre nello stesso posto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomiを長押しして「固定」を選びます。常に同じ位置、先頭に表示されるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomi를 길게 누른 다음 ‘고정’을 선택하세요. 항상 같은 자리, 맨 앞에 표시돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd Tomi ingedrukt en kies “Vastzetten”. Het blijft dan als eerste staan, altijd op dezelfde plek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij i przytrzymaj Tomi, a potem wybierz „Przypnij”. Tomi będzie zawsze pierwsze, w tym samym miejscu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque no Tomi e mantenha pressionado, depois escolha “Fixar”. Ele vai ficar em primeiro, sempre no mesmo lugar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите и удерживайте Tomi, затем выберите «Закрепить». Он всегда будет первым, на одном и том же месте."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomi’ye dokunup basılı tutun, ardından “Sabitle” seçeneğini belirleyin. Hep aynı yerde, ilk sırada kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按 Tomi，然后选择“固定”。它将始终排在第一位，位置不变。"
          }
        }
      }
    },
