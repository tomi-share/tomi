    "ios_notice_files_skipped" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Dateien wurden nicht angehängt: maximal 25 MB pro Datei, höchstens 20 Dateien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some files were not attached: 25 MB maximum per file, 20 files at most."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos archivos no se adjuntaron: 25 MB como máximo por archivo y 20 archivos como máximo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains fichiers n’ont pas été joints : 25 Mo maximum par fichier, 20 fichiers au plus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ फ़ाइलें अटैच नहीं की गईं: हर फ़ाइल के लिए ज़्यादा से ज़्यादा 25 MB, कुल ज़्यादा से ज़्यादा 20 फ़ाइलें।"
