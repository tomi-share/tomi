        "pl" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Twój serwer Tomi nie może już znaleźć twojej przestrzeni. Jeśli został zresetowany, możesz wymazać ten Mac; w przeciwnym razie najpierw sprawdź swój serwer. Na tym Macu nic nie zostało wymazane."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Twój serwer Tomi nie może już znaleźć twojej przestrzeni. Jeśli został zresetowany, możesz wymazać ten telefon; w przeciwnym razie najpierw sprawdź swój serwer. Na tym telefonie nic nie zostało wymazane."
                }
