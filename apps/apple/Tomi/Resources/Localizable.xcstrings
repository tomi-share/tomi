        "ja" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "TomiはこのMacのデータを開けません。アプリのデータが消去または破損した（Macを復元した、アプリのストレージを消去したなど）か、データを保護するキーが使用できなくなった可能性があります。ほかのデバイスには影響ありません。"
                }
