        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una solicitud a tu servidor sigue en curso. Tomi espera a que termine antes de borrar. No se borró nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une demande vers ton serveur est encore en cours. Tomi attend sa fin avant d’effacer. Rien n’a été effacé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके सर्वर को भेजा गया एक अनुरोध अभी चल रहा है। मिटाने से पहले Tomi उसके पूरा होने का इंतज़ार कर रहा है। कुछ भी मिटाया नहीं गया है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permintaan ke server Anda masih berlangsung. Tomi menunggunya selesai sebelum membersihkan. Tidak ada yang dihapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una richiesta al tuo server è ancora in corso. Tomi attende che finisca prima di cancellare. Non è stato cancellato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーへのリクエストがまだ処理中です。Tomiはその完了を待ってから消去します。何も消去されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버로 보낸 요청이 아직 진행 중이에요. Tomi는 요청이 끝난 후에 지워요. 아무것도 지워지지 않았어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er loopt nog een verzoek naar je server. Tomi wacht tot het is afgerond voordat er wordt gewist. Er is niets gewist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żądanie do twojego serwera jest jeszcze w toku. Tomi czeka na jego zakończenie przed wymazaniem. Nic nie zostało wymazane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma solicitação ao seu servidor ainda está em andamento. O Tomi aguarda a conclusão dela antes de apagar. Nada foi apagado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрос к вашему серверу ещё выполняется. Tomi ждёт его завершения, прежде чем стирать. Ничего не стёрто."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucunuza yapılan bir istek hâlâ sürüyor. Tomi temizlemeden önce bunun bitmesini bekliyor. Hiçbir şey silinmedi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发往你的服务器的请求仍在进行中。Tomi 会等它完成后再抹掉。未抹掉任何内容。"
          }
        }
      }
