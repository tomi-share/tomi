    "notif_device_added_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ ist deinem Raum beigetreten. Warst du das nicht? Öffne Geräte und schließe es aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” joined your space. Not you? Open Devices and revoke it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” se unió a tu espacio. ¿No fuiste tú? Abre Dispositivos y revócalo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » a rejoint ton espace. Ce n’est pas toi ? Ouvre Appareils et révoque-le."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” आपके स्पेस से जुड़ गया। यह आप नहीं थे? डिवाइस खोलें और इसे निरस्त करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” bergabung ke ruang Anda. Bukan Anda? Buka Perangkat dan cabut perangkat tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” è entrato nel tuo spazio. Non sei stato tu? Apri Dispositivi e revocalo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」がスペースに加わりました。心当たりがない場合は、「デバイス」を開いて無効化してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”이(가) 내 공간에 참여했어요. 직접 추가하지 않았나요? 기기 화면을 열어 해지하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” neemt nu deel aan je ruimte. Was jij dit niet? Open Apparaten en trek de toegang in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urządzenie „%1$@” dołączyło do twojej przestrzeni. To nie ty? Otwórz Urządzenia i unieważnij je."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” entrou no seu espaço. Não foi você? Abra Dispositivos e revogue-o."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устройство «%1$@» присоединилось к вашему пространству. Это не вы? Откройте «Устройства» и отзовите его."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” alanınıza katıldı. Siz değil misiniz? Cihazlar bölümünü açın ve erişimini kesin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”已加入你的空间。不是你本人？请打开“设备”并吊销它。"
          }
        }
      }
    },
