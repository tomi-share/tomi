    "unreadable_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomi can’t open its data on this phone. The app’s data may have been erased or damaged (phone restored, app storage cleared), or the key that protects it can no longer be used. Your other devices are not affected."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomi n’arrive pas à ouvrir ses données sur ce téléphone. Les données de l’app ont peut-être été effacées ou abîmées (téléphone restauré, stockage de l’app nettoyé), ou la clé qui les protège n’est plus utilisable. Tes autres appareils ne sont pas touchés."
          }
        }
      }
    },
