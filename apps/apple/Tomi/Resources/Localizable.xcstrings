    "unreadable_decryption_failed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Eintrag ist vorerst nicht lesbar. Er bleibt erhalten: Eine Synchronisierung oder ein Update kann ihn lesbar machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This item is unreadable for now. It is kept: a sync or an update may make it readable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este elemento es ilegible por ahora. Se conserva: una sincronización o una actualización podría hacerlo legible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet élément est illisible pour le moment. Il est conservé : une synchronisation ou une mise à jour peut le rendre lisible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह आइटम अभी पढ़ा नहीं जा सकता। इसे रखा गया है: सिंक या अपडेट के बाद यह पढ़ने लायक हो सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Item ini belum dapat dibaca untuk saat ini. Item tetap disimpan: sinkronisasi atau pembaruan mungkin dapat membuatnya terbaca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per ora questo elemento è illeggibile. Viene conservato: una sincronizzazione o un aggiornamento potrebbero renderlo leggibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアイテムは現在読み取れません。アイテムは保持されます。同期またはアップデートで読み取れるようになる可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 이 항목을 읽을 수 없어요. 항목은 보관돼요. 동기화나 업데이트 후 읽을 수 있게 될 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit item is voorlopig onleesbaar. Het wordt bewaard: na een synchronisatie of een update kan het leesbaar worden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten element jest na razie nieczytelny. Zostaje zachowany: synchronizacja lub aktualizacja może sprawić, że stanie się czytelny."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este item está ilegível por enquanto. Ele é mantido: uma sincronização ou uma atualização pode torná-lo legível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот элемент пока не читается. Он сохранён: синхронизация или обновление может сделать его читаемым."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu öğe şimdilik okunamıyor. Saklanıyor: bir eşitleme veya güncelleme onu okunabilir hale getirebilir."
