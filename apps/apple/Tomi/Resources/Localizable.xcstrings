    "ios_debug_enter_demo_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur im Debug-Build. Überspringt die Kopplung (kein Netzwerk, Demodaten) und öffnet den Feed. Andernfalls gib einen beliebigen Code ein (z. B. 7-crayon-lune): Der Bestätigungscode der Demo ist 482913."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debug build only. Bypasses pairing (no network, demo data) and opens the feed. Otherwise, enter any code (e.g. 7-crayon-lune): the demo verification code is 482913."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo en compilaciones de depuración. Omite la vinculación (sin red, datos de demostración) y abre el hilo. Si no, escribe cualquier código (p. ej., 7-crayon-lune): el código de verificación de demostración es 482913."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build debug uniquement. Court-circuite l’appairage (aucun réseau, données de démonstration) et ouvre le fil. Sinon, saisis n’importe quel code (ex. 7-crayon-lune) : le code de vérification de démo est 482913."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ डीबग बिल्ड में। पेयरिंग को छोड़ देता है (नेटवर्क नहीं, डेमो डेटा) और फ़ीड खोलता है। वरना कोई भी कोड डालें (जैसे 7-crayon-lune): डेमो पुष्टि कोड 482913 है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya build debug. Melewati penyambungan (tanpa jaringan, data demo) dan membuka linimasa. Jika tidak, masukkan kode apa saja (mis. 7-crayon-lune): kode verifikasi demo adalah 482913."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo nella build di debug. Salta l’abbinamento (niente rete, dati demo) e apre il feed. Altrimenti, inserisci un codice qualsiasi (es. 7-crayon-lune): il codice di verifica demo è 482913."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバッグビルドのみ。ペアリングを省略して（ネットワークなし、デモデータ）フィードを開きます。それ以外の場合は任意のコード（例：7-crayon-lune）を入力してください。デモの確認コードは482913です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디버그 빌드 전용. 페어링을 건너뛰고(네트워크 없음, 데모 데이터) 피드를 열어요. 아니면 아무 코드나 입력하세요(예: 7-crayon-lune). 데모 확인 코드는 482913이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen in debugbuild. Slaat het koppelen over (geen netwerk, demogegevens) en opent de feed. Voer anders een willekeurige code in (bijv. 7-crayon-lune): de demoverificatiecode is 482913."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko w kompilacji debug. Pomija parowanie (bez sieci, dane demonstracyjne) i otwiera strumień. W przeciwnym razie wpisz dowolny kod (np. 7-crayon-lune): demonstracyjny kod weryfikacyjny to 482913."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas em build de depuração. Pula o pareamento (sem rede, dados de demonstração) e abre o feed. Caso contrário, digite qualquer código (ex.: 7-crayon-lune): o código de verificação da demonstração é 482913."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только в отладочной сборке. Пропускает сопряжение (без сети, демо-данные) и открывает ленту. Иначе введите любой код (например, 7-crayon-lune): демо-код проверки — 482913."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca hata ayıklama derlemesi. Eşlemeyi atlar (ağ yok, demo verileri) ve akışı açar. Aksi halde herhangi bir kod girin (ör. 7-crayon-lune): demo doğrulama kodu 482913."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅限调试版本。跳过配对（无网络、演示数据）并打开信息流。否则，输入任意邀请码（例如 7-crayon-lune）：演示验证码为 482913。"
          }
        }
      }
    },
