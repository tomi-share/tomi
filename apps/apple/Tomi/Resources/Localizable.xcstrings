    "channel_secrets_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empfangene verborgene Inhalte. Nie auf dem Sperrbildschirm angezeigt, ohne Vorschau."
          }
