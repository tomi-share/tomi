    "space_revoked_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Dieser Mac wurde aus deinem Raum entfernt. Seine Inhalte bleiben hier lesbar. Durch das Abmelden werden sie gelöscht."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Dieses Telefon wurde aus deinem Raum entfernt. Seine Inhalte bleiben hier lesbar. Durch das Abmelden werden sie gelöscht."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This Mac has been removed from your space. What it holds stays readable here. Disconnecting erases it."
