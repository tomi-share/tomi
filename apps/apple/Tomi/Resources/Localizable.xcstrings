    "pair_waiting_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestätige auch auf %1$@, dass die Codes identisch sind. Das Gerät wird hinzugefügt, sobald das erledigt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Also confirm on %1$@ that the codes are identical. Adding the device finishes as soon as that is done."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirma también en %1$@ que los códigos son idénticos. La vinculación termina en cuanto lo hagas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirme aussi sur %1$@ que les codes sont identiques. L’ajout de l’appareil se termine dès que c’est fait."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ पर भी पुष्टि करें कि कोड एक जैसे हैं। ऐसा होते ही डिवाइस जोड़ना पूरा हो जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfirmasi juga di %1$@ bahwa kodenya sama. Penambahan perangkat selesai begitu hal itu dilakukan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conferma anche su %1$@ che i codici sono identici. L’aggiunta del dispositivo si completa appena fatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@でも、コードが同じであることを確認してください。確認が済むとすぐにデバイスの追加が完了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서도 코드가 같다고 확인하세요. 확인하면 바로 기기 추가가 완료돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevestig ook op %1$@ dat de codes hetzelfde zijn. Het apparaat is toegevoegd zodra dat is gebeurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potwierdź też na urządzeniu %1$@, że kody są identyczne. Dodawanie urządzenia zakończy się zaraz potem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirme também em %1$@ que os códigos são idênticos. A adição do dispositivo termina assim que isso for feito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подтвердите и на устройстве %1$@, что коды совпадают. После этого добавление устройства завершится."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodların aynı olduğunu %1$@ cihazında da onaylayın. Bu yapılır yapılmaz cihaz ekleme tamamlanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也请在 %1$@ 上确认验证码相同。确认后即可完成添加设备。"
          }
        }
      }
    },
