    "feed_empty" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nichts da. Teile einen Link, einen Text oder eine Datei mit Tomi, um sie an deine anderen Geräte zu senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing yet. Share a link, a text or a file to Tomi to send it to your other devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada por ahora. Comparte un enlace, un texto o un archivo con Tomi para enviarlo a tus otros dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien pour l’instant. Partage un lien, un texte ou un fichier vers Tomi pour l’envoyer à tes autres appareils."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी यहाँ कुछ नहीं है। अपने दूसरे डिवाइस पर भेजने के लिए कोई लिंक, टेक्स्ट या फ़ाइल Tomi पर शेयर करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada apa-apa. Bagikan tautan, teks, atau file ke Tomi untuk mengirimnya ke perangkat Anda yang lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora niente. Condividi un link, un testo o un file con Tomi per inviarlo agli altri tuoi dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ何もありません。リンク、テキスト、ファイルをTomiに共有すると、ほかのデバイスに送信できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 아무것도 없어요. 링크, 텍스트, 파일을 Tomi로 공유하면 다른 기기로 보낼 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog niets. Deel een link, een tekst of een bestand met Tomi om het naar je andere apparaten te versturen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeszcze nic tu nie ma. Udostępnij Tomi link, tekst lub plik, aby wysłać go na swoje pozostałe urządzenia."
          }
        },
        "pt" : {
          "stringUnit" : {
