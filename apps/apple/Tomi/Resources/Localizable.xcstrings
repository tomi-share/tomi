    "pair_link_received_warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Link stammt aus einer anderen App oder von einer Webseite. Tritt nur einem Raum bei, den du gerade selbst erstellt hast, mit einem Relay, das du kennst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This link comes from another app or a web page. Only join a space you have just created yourself, with a relay you recognize."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este enlace proviene de otra app o de una página web. Únete solo a un espacio que acabas de crear, con un retransmisor que reconozcas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce lien vient d’une autre application ou d’une page web. Rejoins uniquement un espace que tu viens de créer toi-même, avec un relais que tu reconnais."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह लिंक किसी दूसरे ऐप या वेब पेज से आया है। सिर्फ़ उसी स्पेस से जुड़ें जो आपने अभी खुद बनाया है, ऐसे रिले के साथ जिसे आप पहचानते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tautan ini berasal dari aplikasi lain atau halaman web. Hanya gabung ke ruang yang baru saja Anda buat sendiri, dengan relai yang Anda kenali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo link proviene da un’altra app o da una pagina web. Entra solo in uno spazio che hai appena creato tu stesso, con un relay che riconosci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリンクはほかのアプリまたはウェブページから来たものです。自分で作成したばかりのスペースに、見覚えのあるリレーでのみ参加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 링크는 다른 앱이나 웹 페이지에서 왔어요. 방금 직접 만든 공간에만, 내가 아는 릴레이로 참여하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze link komt uit een andere app of van een webpagina. Neem alleen deel aan een ruimte die je zelf net hebt aangemaakt, met een relay die je herkent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten link pochodzi z innej aplikacji lub strony internetowej. Dołączaj tylko do własnej, dopiero co utworzonej przestrzeni, z przekaźnikiem, który znasz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este link vem de outro app ou de uma página da web. Só entre em um espaço que você mesmo acabou de criar, com um retransmissor que você reconhece."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта ссылка получена из другого приложения или с веб-страницы. Присоединяйтесь только к пространству, которое вы только что создали сами, и только с ретранслятором, который вы знаете."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bağlantı başka bir uygulamadan veya bir web sayfasından geliyor. Yalnızca az önce kendiniz oluşturduğunuz bir alana, tanıdığınız bir aktarıcıyla katılın."
          }
        },
        "zh-Hans" : {
