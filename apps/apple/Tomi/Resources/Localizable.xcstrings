        "pl" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tomi nie może otworzyć swoich danych na tym Macu. Dane aplikacji mogły zostać wymazane lub uszkodzone (przywrócenie Maca, wyczyszczenie pamięci aplikacji) albo klucza, który je chroni, nie da się już użyć. Twoje pozostałe urządzenia nie są tym objęte."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tomi nie może otworzyć swoich danych na tym telefonie. Dane aplikacji mogły zostać wymazane lub uszkodzone (przywrócenie telefonu, wyczyszczenie pamięci aplikacji) albo klucza, który je chroni, nie da się już użyć. Twoje pozostałe urządzenia nie są tym objęte."
                }
