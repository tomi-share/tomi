        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "받은 숨김 콘텐츠. 잠금 화면에 표시되지 않으며 미리보기도 없어요."
          }
        },
        "nl" : {
          "stringUnit" : {
