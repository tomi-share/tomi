    "ios_relay_revoked_admin" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wurde vom Administrator des Relays entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ was removed by the administrator of the relay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El administrador del retransmisor quitó %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a été retiré par l’administrateur du relais."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिले के एडमिनिस्ट्रेटर ने %1$@ को हटा दिया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ dikeluarkan oleh administrator relai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ è stato rimosso dall’amministratore del relay."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@はリレーの管理者によって除外されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "릴레이 관리자가 %1$@을(를) 제거했어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is uit de ruimte gehaald door de beheerder van de relay."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urządzenie %1$@ zostało wykluczone przez administratora przekaźnika."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ foi removido pelo administrador do retransmissor."
