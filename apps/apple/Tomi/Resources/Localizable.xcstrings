            "value" : "निरस्त किया जा रहा है: स्पेस कुंजी बदली जा रही है, इसमें कुछ सेकंड लग सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mencabut: kunci ruang sedang diperbarui, ini dapat memakan waktu beberapa detik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revoca in corso: la chiave dello spazio viene rinnovata, può richiedere qualche secondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無効化しています。スペースのキーを更新中のため、数秒かかることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해지 중: 공간 키를 갱신하고 있어요. 몇 초 걸릴 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toegang wordt ingetrokken: de sleutel van de ruimte wordt vernieuwd, dit kan enkele seconden duren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unieważnianie: klucz przestrzeni jest odnawiany, może to potrwać kilka sekund."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revogando: a chave do espaço está sendo renovada, isso pode levar alguns segundos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отзыв: ключ пространства обновляется, это может занять несколько секунд."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erişim kesiliyor: alan anahtarı yenileniyor, bu birkaç saniye sürebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在吊销：空间密钥正在更新，这可能需要几秒钟。"
          }
        }
      }
    },
