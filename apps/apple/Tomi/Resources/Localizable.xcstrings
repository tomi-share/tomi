    "ios_capture_cover_pairing" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bildschirm dieses iPhone wird geteilt oder aufgezeichnet. Tomi verdeckt den Kopplungscode, damit er nicht in der Kopie erscheint: Wer ihn sieht, könnte deinem Raum beitreten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The screen of this iPhone is being shared or recorded. Tomi covers the pairing code so that it does not appear in the copy: someone who saw it could join your space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se está compartiendo o grabando la pantalla de este iPhone. Tomi cubre el código de vinculación para que no aparezca en la copia: alguien que lo viera podría unirse a tu espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’écran de cet iPhone est partagé ou enregistré. Tomi cache le code d’appairage pour qu’il n’apparaisse pas dans la copie : quelqu’un qui le verrait pourrait rejoindre ton espace."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस iPhone की स्क्रीन शेयर या रिकॉर्ड हो रही है। Tomi पेयरिंग कोड को ढक देता है ताकि वह कॉपी में न दिखे: जिसने इसे देखा हो, वह आपके स्पेस से जुड़ सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layar iPhone ini sedang dibagikan atau direkam. Tomi menutupi kode penyambungan agar tidak muncul di salinannya: orang yang melihatnya dapat bergabung ke ruang Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo schermo di questo iPhone viene condiviso o registrato. Tomi copre il codice di abbinamento perché non compaia nella copia: chi lo vedesse potrebbe entrare nel tuo spazio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneの画面が共有または収録されています。コピーに写らないよう、Tomiがペアリングコードを覆っています。コードを見た人がスペースに参加できてしまうためです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone의 화면이 공유되거나 녹화되고 있어요. 복사본에 나타나지 않도록 Tomi가 페어링 코드를 가려요. 코드를 본 사람은 내 공간에 참여할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het scherm van deze iPhone wordt gedeeld of opgenomen. Tomi bedekt de koppelcode zodat hij niet in de kopie verschijnt: iemand die hem ziet, zou aan je ruimte kunnen deelnemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran tego iPhone’a jest udostępniany lub nagrywany. Tomi zakrywa kod parowania, aby nie pojawił się w kopii: ktoś, kto go zobaczy, mógłby dołączyć do twojej przestrzeni."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tela deste iPhone está sendo compartilhada ou gravada. O Tomi cobre o código de pareamento para que ele não apareça na cópia: alguém que o visse poderia entrar no seu espaço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экран этого iPhone транслируется или записывается. Tomi закрывает код сопряжения, чтобы он не попал в копию: тот, кто его увидит, сможет присоединиться к вашему пространству."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu iPhone’un ekranı paylaşılıyor veya kaydediliyor. Tomi, kopyada görünmemesi için eşleme kodunu örtüyor: kodu gören biri alanınıza katılabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 iPhone 的屏幕正在被共享或录制。Tomi 会遮盖配对码，使其不出现在副本中：看到配对码的人可能会加入你的空间。"
          }
        }
      }
    },
