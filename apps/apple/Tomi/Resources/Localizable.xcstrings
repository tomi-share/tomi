          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirma también en %1$@ que los códigos son idénticos. El dispositivo se agrega en cuanto lo hagas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirme aussi sur %1$@ que les codes sont identiques. L’appareil est ajouté dès que c’est fait."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ पर भी पुष्टि करें कि कोड एक जैसे हैं। ऐसा होते ही डिवाइस जुड़ जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfirmasi juga di %1$@ bahwa kodenya sama. Perangkat ditambahkan begitu hal itu dilakukan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conferma anche su %1$@ che i codici sono identici. Il dispositivo viene aggiunto appena fatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@でも、コードが同じであることを確認してください。確認が済むとすぐにデバイスが追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서도 코드가 같다고 확인하세요. 확인하면 바로 기기가 추가돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevestig ook op %1$@ dat de codes hetzelfde zijn. Het apparaat wordt toegevoegd zodra dat is gebeurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potwierdź też na urządzeniu %1$@, że kody są identyczne. Urządzenie zostanie dodane zaraz potem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirme também em %1$@ que os códigos são idênticos. O dispositivo é adicionado assim que isso for feito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подтвердите и на устройстве %1$@, что коды совпадают. После этого устройство будет добавлено."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodların aynı olduğunu %1$@ cihazında da onaylayın. Bu yapılır yapılmaz cihaz eklenir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也请在 %1$@ 上确认验证码相同。确认后即可添加设备。"
          }
        }
      }
    },
