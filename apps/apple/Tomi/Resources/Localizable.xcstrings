    "pair_error_blocked" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät kann deinen Tomi-Server nicht mehr nutzen. Prüfe, ob es noch zu deinem Raum gehört."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device can no longer use your Tomi server. Check that it is still part of your space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo ya no puede usar tu servidor Tomi. Comprueba que siga formando parte de tu espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil ne peut plus utiliser ton serveur Tomi. Vérifie qu’il fait toujours partie de ton espace."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह डिवाइस अब आपके Tomi सर्वर का इस्तेमाल नहीं कर सकता। जाँचें कि यह अब भी आपके स्पेस का हिस्सा है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perangkat ini tidak dapat lagi menggunakan server Tomi Anda. Pastikan perangkat ini masih menjadi bagian dari ruang Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo non può più usare il tuo server Tomi. Controlla che faccia ancora parte del tuo spazio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスはTomiサーバーを使用できなくなりました。まだスペースに含まれているか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기는 더 이상 Tomi 서버를 사용할 수 없어요. 아직 내 공간에 속해 있는지 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit apparaat kan je Tomi-server niet meer gebruiken. Controleer of het nog deel uitmaakt van je ruimte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To urządzenie nie może już korzystać z twojego serwera Tomi. Sprawdź, czy nadal należy do twojej przestrzeni."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo não pode mais usar seu servidor Tomi. Confira se ele ainda faz parte do seu espaço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это устройство больше не может использовать ваш сервер Tomi. Проверьте, что оно всё ещё входит в ваше пространство."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihaz artık Tomi sunucunuzu kullanamıyor. Hâlâ alanınızın bir parçası olduğunu kontrol edin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台设备无法再使用你的 Tomi 服务器。请检查它是否仍在你的空间中。"
          }
        }
      }
    },
