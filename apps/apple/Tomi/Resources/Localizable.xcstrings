    "macos_settings_copy_selection_denied" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um die Auswahl zu kopieren, muss macOS Tomi erlauben (Systemeinstellungen > Datenschutz & Sicherheit > Bedienungshilfen). Ohne diese Erlaubnis öffnet der Kurzbefehl das Senden, ohne etwas zu kopieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To copy the selection, macOS must allow Tomi (System Settings, Privacy & Security, Accessibility). Without this, the shortcut opens Send without copying anything."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para copiar la selección, macOS debe permitir Tomi (Ajustes del Sistema, Privacidad y seguridad, Accesibilidad). Si no, el atajo abre el envío sin copiar nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour copier la sélection, macOS doit autoriser Tomi (Réglages Système, Confidentialité et sécurité, Accessibilité). Sans cela, ce raccourci ouvre l’envoi sans rien copier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुना हुआ कॉपी करने के लिए macOS को Tomi को अनुमति देनी होगी (सिस्टम सेटिंग्ज़, गोपनीयता और सुरक्षा, ऐक्सेसिबिलिटी)। इसके बिना यह शॉर्टकट कुछ कॉपी किए बिना भेजना खोलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk menyalin pilihan, macOS harus mengizinkan Tomi (Pengaturan Sistem, Privasi & Keamanan, Aksesibilitas). Tanpa izin ini, pintasan ini membuka pengiriman tanpa menyalin apa pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per copiare la selezione, macOS deve autorizzare Tomi (Impostazioni di Sistema, Privacy e sicurezza, Accessibilità). Senza questa autorizzazione, la scorciatoia apre l’invio senza copiare nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択内容をコピーするには、macOSでTomiを許可する必要があります（システム設定 > プライバシーとセキュリティ > アクセシビリティ）。許可しない場合、このショートカットは何もコピーせずに送信画面を開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택 항목을 복사하려면 macOS에서 Tomi를 허용해야 해요(시스템 설정, 개인정보 보호 및 보안, 손쉬운 사용). 허용하지 않으면 단축키는 아무것도 복사하지 않고 보내기 화면만 열어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om de selectie te kopiëren, moet macOS Tomi toestaan (Systeeminstellingen, Privacy en beveiliging, Toegankelijkheid). Zonder die toestemming opent deze toetscombinatie Versturen zonder iets te kopiëren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby skopiować zaznaczenie, macOS musi zezwolić Tomi (Ustawienia systemowe, Prywatność i ochrona, Dostępność). Bez tego ten skrót otwiera wysyłanie bez kopiowania czegokolwiek."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para copiar a seleção, o macOS precisa permitir o Tomi (Ajustes do Sistema, Privacidade e Segurança, Acessibilidade). Sem isso, o atalho abre o envio sem copiar nada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы копировать выделенное, macOS должна разрешить это Tomi (Системные настройки › Конфиденциальность и безопасность › Универсальный доступ). Без этого сочетание открывает отправку, ничего не копируя."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçimi kopyalamak için macOS’in Tomi’ye izin vermesi gerekir (Sistem Ayarları > Gizlilik ve Güvenlik > Erişilebilirlik). Bu izin olmadan kısayol, hiçbir şey kopyalamadan gönderimi açar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如需复制所选内容，macOS 必须允许 Tomi（“系统设置”>“隐私与安全性”>“辅助功能”）。否则，快捷键只会打开发送界面，不会复制任何内容。"
          }
        }
      }
    },
