    "create_error_name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Gerätename muss 1 bis 64 Zeichen lang sein, ohne Leerzeichen am Anfang oder Ende."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
