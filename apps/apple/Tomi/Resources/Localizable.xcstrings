    "invite_single_use" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Code funktioniert nur einmal. Er erneuert sich, solange dieser Bildschirm geöffnet bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This code works only once. It renews itself as long as this screen stays open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este código solo funciona una vez. Se renueva solo mientras esta pantalla siga abierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce code ne sert qu’une fois. Il se renouvelle tout seul tant que cet écran reste ouvert."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह कोड सिर्फ़ एक बार काम करता है। जब तक यह स्क्रीन खुली है, यह अपने-आप नया होता रहता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kode ini hanya berlaku sekali. Kode diperbarui sendiri selama layar ini tetap terbuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo codice funziona una sola volta. Si rinnova finché questa schermata resta aperta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコードは1回だけ使えます。この画面を開いている間、自動的に更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 코드는 한 번만 사용할 수 있어요. 이 화면이 열려 있는 동안 자동으로 갱신돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze code werkt maar één keer. Hij wordt vernieuwd zolang dit scherm open blijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten kod działa tylko raz. Odnawia się, dopóki ten ekran jest otwarty."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este código funciona só uma vez. Ele se renova sozinho enquanto esta tela estiver aberta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот код действует только один раз. Он обновляется, пока этот экран открыт."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kod yalnızca bir kez çalışır. Bu ekran açık kaldığı sürece kendini yeniler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此邀请码只能使用一次。只要此屏幕保持打开，它就会自动更新。"
          }
        }
      }
