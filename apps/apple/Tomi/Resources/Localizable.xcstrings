    "invite_auth_required_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Um ein Gerät hinzuzufügen, bestätige deine Identität mit Touch ID oder dem Passwort dieses Mac."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Um ein Gerät hinzuzufügen, bestätige deine Identität mit deinem Fingerabdruck, deinem Gesicht oder dem Code der Displaysperre des Telefons."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "To add a device, confirm your identity with Touch ID or this Mac’s password."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "To add a device, confirm your identity with your fingerprint, your face or the phone’s screen lock code."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Para agregar un dispositivo, confirma tu identidad con Touch ID o la contraseña de este Mac."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Para agregar un dispositivo, confirma tu identidad con tu huella digital, tu rostro o el código de bloqueo de pantalla del teléfono."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Pour ajouter un appareil, confirme ton identité avec Touch ID ou le mot de passe de ce Mac."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Pour ajouter un appareil, confirme ton identité avec ton empreinte, ton visage ou le code de verrouillage du téléphone."
                }
              }
            }
          }
        },
        "hi" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "डिवाइस जोड़ने के लिए Touch ID या इस Mac के पासवर्ड से अपनी पहचान की पुष्टि करें।"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "डिवाइस जोड़ने के लिए अपने फ़िंगरप्रिंट, अपने चेहरे या फ़ोन के स्क्रीन लॉक कोड से अपनी पहचान की पुष्टि करें।"
                }
              }
            }
          }
        },
        "id" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Untuk menambahkan perangkat, konfirmasi identitas Anda dengan Touch ID atau kata sandi Mac ini."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Untuk menambahkan perangkat, konfirmasi identitas Anda dengan sidik jari, wajah, atau kode kunci layar ponsel Anda."
                }
              }
            }
          }
        },
        "it" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Per aggiungere un dispositivo, conferma la tua identità con Touch ID o la password di questo Mac."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Per aggiungere un dispositivo, conferma la tua identità con la tua impronta, il tuo volto o il codice di blocco schermo del telefono."
                }
              }
            }
          }
        },
        "ja" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "デバイスを追加するには、Touch IDまたはこのMacのパスワードで本人確認をしてください。"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "デバイスを追加するには、指紋、顔、またはスマートフォンの画面ロックのコードで本人確認をしてください。"
                }
              }
            }
          }
        },
        "ko" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "기기를 추가하려면 Touch ID 또는 이 Mac의 암호로 본인 확인을 하세요."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "기기를 추가하려면 지문, 얼굴 또는 휴대전화의 화면 잠금 코드로 본인 확인을 하세요."
                }
              }
            }
          }
        },
        "nl" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Bevestig je identiteit met Touch ID of het wachtwoord van deze Mac om een apparaat toe te voegen."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Bevestig je identiteit met je vingerafdruk, je gezicht of de schermvergrendelingscode van de telefoon om een apparaat toe te voegen."
                }
              }
            }
          }
        },
        "pl" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Aby dodać urządzenie, potwierdź swoją tożsamość za pomocą Touch ID lub hasła tego Maca."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Aby dodać urządzenie, potwierdź swoją tożsamość odciskiem palca, twarzą lub kodem blokady ekranu telefonu."
                }
              }
            }
          }
        },
        "pt" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Para adicionar um dispositivo, confirme sua identidade com o Touch ID ou a senha deste Mac."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Para adicionar um dispositivo, confirme sua identidade com sua digital, seu rosto ou o código de bloqueio de tela do celular."
                }
              }
            }
          }
        },
        "ru" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Чтобы добавить устройство, подтвердите личность с помощью Touch ID или пароля этого Mac."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Чтобы добавить устройство, подтвердите личность отпечатком пальца, лицом или кодом блокировки экрана телефона."
                }
              }
            }
          }
        },
        "tr" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Cihaz eklemek için Touch ID veya bu Mac’in parolasıyla kimliğinizi doğrulayın."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Cihaz eklemek için parmak iziniz, yüzünüz veya telefonun ekran kilidi koduyla kimliğinizi doğrulayın."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "如需添加设备，请使用 Touch ID 或这台 Mac 的密码验证身份。"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "如需添加设备，请使用你的指纹、面孔或手机的锁屏密码验证身份。"
                }
              }
            }
          }
        }
      }
