            }
          }
        },
        "id" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tomi tidak dapat membuka datanya di Mac ini. Data aplikasi mungkin telah dihapus atau rusak (Mac dipulihkan, penyimpanan aplikasi dikosongkan), atau kunci yang melindunginya tidak dapat digunakan lagi. Perangkat Anda yang lain tidak terpengaruh."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tomi tidak dapat membuka datanya di ponsel ini. Data aplikasi mungkin telah dihapus atau rusak (ponsel dipulihkan, penyimpanan aplikasi dikosongkan), atau kunci yang melindunginya tidak dapat digunakan lagi. Perangkat Anda yang lain tidak terpengaruh."
                }
