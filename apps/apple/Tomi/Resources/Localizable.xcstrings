    "channel_devices_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis, wenn deinem Raum ein Gerät hinzugefügt wird. Kein Inhalt, nur der Name des Geräts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alert when a device is added to your space. No content, only the name of the device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso cuando se agrega un dispositivo a tu espacio. Sin contenido, solo el nombre del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerte quand un appareil est ajouté à ton espace. Aucun contenu, seulement le nom de l’appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके स्पेस में कोई डिवाइस जुड़ने पर सूचना। कोई कॉन्टेंट नहीं, सिर्फ़ डिवाइस का नाम।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peringatan saat perangkat ditambahkan ke ruang Anda. Tanpa konten, hanya nama perangkat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avviso quando un dispositivo viene aggiunto al tuo spazio. Nessun contenuto, solo il nome del dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スペースにデバイスが追加されたときに通知します。内容は含まれず、デバイスの名前のみです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 공간에 기기가 추가되면 알려요. 콘텐츠는 없고 기기 이름만 표시돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melding wanneer er een apparaat aan je ruimte wordt toegevoegd. Geen inhoud, alleen de naam van het apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiadomienie, gdy do twojej przestrzeni zostanie dodane urządzenie. Bez treści, tylko nazwa urządzenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerta quando um dispositivo é adicionado ao seu espaço. Nenhum conteúdo, apenas o nome do dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оповещение, когда в ваше пространство добавлено устройство. Без содержимого, только название устройства."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
