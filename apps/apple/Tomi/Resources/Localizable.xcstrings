        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह इकलौता डिवाइस है। डिस्कनेक्ट करने से आपका स्पेस और उसमें मौजूद सब कुछ हमेशा के लिए डिलीट हो जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini satu-satunya perangkat. Memutuskan sambungan akan menghapus ruang Anda beserta seluruh isinya secara permanen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo è l’unico dispositivo. Disconnetterti elimina il tuo spazio e tutto ciò che contiene, in modo definitivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これが唯一のデバイスです。接続を解除すると、スペースとその中身がすべて完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유일한 기기예요. 연결을 해제하면 내 공간과 그 안의 모든 것이 영구적으로 삭제돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is het enige apparaat. Loskoppelen verwijdert je ruimte en alles erin, definitief."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To jedyne urządzenie. Rozłączenie usunie twoją przestrzeń i wszystko, co w niej jest, na zawsze."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este é o único dispositivo. Desconectar exclui seu espaço e tudo o que ele contém, permanentemente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это единственное устройство. Отключение навсегда удалит ваше пространство и всё его содержимое."
          }
        },
        "tr" : {
          "stringUnit" : {
