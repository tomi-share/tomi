    "ios_notif_device_added_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ gehört jetzt zu deinem Raum. Warst du das nicht? Entferne es unter Geräte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is now part of your space. Not you? Remove it from Devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ahora forma parte de tu espacio. ¿No fuiste tú? Quítalo desde Dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ fait maintenant partie de ton espace. Ce n’était pas toi ? Retire-le depuis Appareils."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ अब आपके स्पेस का हिस्सा है। यह आप नहीं थे? इसे डिवाइस से हटाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kini menjadi bagian dari ruang Anda. Bukan Anda? Keluarkan dari Perangkat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ fa ora parte del tuo spazio. Non sei stato tu? Rimuovilo da Dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@がスペースに加わりました。心当たりがない場合は、「デバイス」から除外してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@이(가) 이제 내 공간에 속해 있어요. 직접 추가하지 않았나요? 기기에서 제거하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ maakt nu deel uit van je ruimte. Was jij dit niet? Haal het weg via Apparaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urządzenie %1$@ należy teraz do twojej przestrzeni. To nie ty? Wyklucz je w sekcji Urządzenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ agora faz parte do seu espaço. Não foi você? Remova-o em Dispositivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устройство %1$@ теперь в вашем пространстве. Это не вы? Исключите его в разделе «Устройства»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ artık alanınızın bir parçası. Siz değil misiniz? Cihazlar bölümünden çıkarın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 现已加入你的空间。不是你本人？请在“设备”中将其移除。"
          }
        }
      }
    },
