      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist das einzige Gerät. Das Abmelden löscht deinen Raum und alles darin endgültig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is the only device. Disconnecting deletes your space and everything in it, permanently."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este es el único dispositivo. Desconectarlo elimina tu espacio y todo su contenido de forma permanente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu es le seul appareil. Se déconnecter supprime ton espace et tout son contenu, définitivement."
