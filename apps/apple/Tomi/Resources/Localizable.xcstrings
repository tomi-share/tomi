    "ios_misconfigured_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff auf den Schlüsselbund des Systems wird ihr verweigert, daher kann Tomi seine Daten nicht öffnen. Nichts ist beschädigt oder gelöscht: Installiere eine Version, die mit der Kennung der App signiert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is denied access to the system Keychain, so Tomi cannot open its data. Nothing is damaged or erased: install a version signed with the app’s identifier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sistema le deniega el acceso al llavero, así que Tomi no puede abrir sus datos. No se dañó ni se borró nada: instala una versión firmada con el identificador de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le trousseau du système lui est refusé, donc Tomi ne peut pas ouvrir ses données. Rien n’est abîmé ni effacé : installe une version signée avec l’identifiant de l’app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे सिस्टम का कीचेन इस्तेमाल करने की अनुमति नहीं है, इसलिए Tomi अपना डेटा नहीं खोल सकता। कुछ भी खराब या मिटाया नहीं गया है: ऐप के आइडेंटिफ़ायर से साइन किया गया वर्शन इंस्टॉल करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses ke rantai kunci sistem ditolak, sehingga Tomi tidak dapat membuka datanya. Tidak ada yang rusak atau dihapus: instal versi yang ditandatangani dengan pengenal aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il portachiavi di sistema le è negato, quindi Tomi non può aprire i suoi dati. Niente è danneggiato o cancellato: installa una versione firmata con l’identificativo dell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムのキーチェーンへのアクセスが拒否されているため、Tomiはデータを開けません。何も破損・消去されていません。アプリのIDで署名されたバージョンをインストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 키체인 접근이 거부되어 Tomi가 데이터를 열 수 없어요. 손상되거나 지워진 것은 없어요. 앱 식별자로 서명된 버전을 설치하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De sleutelhanger van het systeem wordt haar geweigerd, dus Tomi kan zijn gegevens niet openen. Er is niets beschadigd of gewist: installeer een versie die is ondertekend met de identificatie van de app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System odmawia jej dostępu do pęku kluczy, więc Tomi nie może otworzyć swoich danych. Nic nie zostało uszkodzone ani wymazane: zainstaluj wersję podpisaną identyfikatorem aplikacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sistema nega a ela o acesso às Chaves, então o Tomi não consegue abrir os próprios dados. Nada foi danificado nem apagado: instale uma versão assinada com o identificador do app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Системная связка ключей ей недоступна, поэтому Tomi не может открыть свои данные. Ничего не повреждено и не стёрто: установите версию, подписанную идентификатором приложения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistemin Anahtar Zinciri’ne erişimi reddediliyor, bu yüzden Tomi verilerini açamıyor. Hiçbir şey bozulmadı veya silinmedi: uygulamanın tanımlayıcısıyla imzalanmış bir sürüm yükleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统钥匙串拒绝了它的访问，因此 Tomi 无法打开它的数据。没有任何内容被损坏或抹掉：请安装使用该 App 标识符签名的版本。"
          }
        }
      }
    },
