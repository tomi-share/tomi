    "toast_biometric_unavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Weder Touch ID noch das Passwort dieses Mac kann verwendet werden: Verborgene Inhalte können nicht angezeigt, kopiert oder geteilt werden."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Richte eine Displaysperre oder Biometrie ein, um verborgene Inhalte anzuzeigen, zu kopieren oder zu teilen."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Neither Touch ID nor this Mac’s password can be used: hidden content cannot be shown, copied or shared."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Set up a screen lock or biometrics to show, copy or share hidden content."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "No se puede usar Touch ID ni la contraseña de este Mac: el contenido oculto no se puede mostrar, copiar ni compartir."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Configura un bloqueo de pantalla o la biometría para mostrar, copiar o compartir contenido oculto."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ni Touch ID ni le mot de passe de ce Mac ne sont utilisables : impossible d’afficher, de copier ou de partager les contenus masqués."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Configure un verrouillage d’écran ou une biométrie pour afficher, copier ou partager les contenus masqués."
                }
              }
            }
          }
        },
        "hi" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "न Touch ID और न ही इस Mac का पासवर्ड इस्तेमाल किया जा सकता है: छिपा हुआ कॉन्टेंट दिखाया, कॉपी या शेयर नहीं किया जा सकता।"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "छिपा हुआ कॉन्टेंट दिखाने, कॉपी करने या शेयर करने के लिए स्क्रीन लॉक या बायोमेट्रिक्स सेट अप करें।"
                }
              }
            }
          }
        },
        "id" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Touch ID maupun kata sandi Mac ini tidak dapat digunakan: konten tersembunyi tidak dapat ditampilkan, disalin, atau dibagikan."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Siapkan kunci layar atau biometrik untuk menampilkan, menyalin, atau membagikan konten tersembunyi."
                }
              }
            }
          }
        },
        "it" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Non è possibile usare né Touch ID né la password di questo Mac: i contenuti nascosti non possono essere mostrati, copiati o condivisi."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Configura un blocco schermo o la biometria per mostrare, copiare o condividere contenuti nascosti."
                }
              }
            }
          }
        },
        "ja" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Touch IDもこのMacのパスワードも使用できないため、非表示のコンテンツを表示、コピー、共有できません。"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "非表示のコンテンツを表示、コピー、共有するには、画面ロックまたは生体認証を設定してください。"
                }
              }
            }
          }
        },
        "ko" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Touch ID와 이 Mac의 암호를 모두 사용할 수 없어 숨김 콘텐츠를 보거나 복사하거나 공유할 수 없어요."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "숨김 콘텐츠를 보거나 복사하거나 공유하려면 화면 잠금 또는 생체 인식을 설정하세요."
                }
              }
            }
          }
        },
        "nl" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Touch ID en het wachtwoord van deze Mac zijn allebei niet bruikbaar: verborgen inhoud kan niet worden getoond, gekopieerd of gedeeld."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Stel een schermvergrendeling of biometrie in om verborgen inhoud te tonen, te kopiëren of te delen."
                }
              }
            }
          }
        },
        "pl" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Nie można użyć ani Touch ID, ani hasła tego Maca: nie można pokazywać, kopiować ani udostępniać ukrytej treści."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Skonfiguruj blokadę ekranu lub biometrię, aby pokazywać, kopiować i udostępniać ukrytą treść."
