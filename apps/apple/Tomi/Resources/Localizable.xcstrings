      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything Tomi holds here will be erased and this phone will have to join your space again. Your other devices keep their items; remember to remove this old device from their device list."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce que Tomi contient ici sera effacé et ce téléphone devra rejoindre ton espace à nouveau. Tes autres appareils gardent leurs éléments ; pense à retirer cet ancien appareil depuis leur liste des appareils."
          }
        }
      }
