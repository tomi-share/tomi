    "hint_secret_heuristic" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Inhalt sieht nach einem Passwort oder Schlüssel aus: Er wird verborgen. Du kannst das ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This content looks like a password or a key: it is hidden. You can change this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este contenido parece una contraseña o una clave: está oculto. Puedes cambiarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce contenu ressemble à un mot de passe ou à une clé : il est masqué. Tu peux le modifier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह कॉन्टेंट पासवर्ड या कुंजी जैसा लगता है: इसे छिपाया गया है। आप इसे बदल सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konten ini tampak seperti kata sandi atau kunci: konten disembunyikan. Anda dapat mengubahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo contenuto sembra una password o una chiave: è nascosto. Puoi cambiarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコンテンツはパスワードまたはキーのようなので、非表示になっています。変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 콘텐츠는 비밀번호나 키로 보여서 숨겼어요. 변경할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze inhoud lijkt op een wachtwoord of een sleutel: hij wordt verborgen. Je kunt dit wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta treść wygląda na hasło lub klucz: jest ukryta. Możesz to zmienić."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este conteúdo parece uma senha ou uma chave: ele está oculto. Você pode mudar isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это содержимое похоже на пароль или ключ: оно скрыто. Это можно изменить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu içerik bir parolaya veya anahtara benziyor: gizlendi. Bunu değiştirebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此内容看起来像密码或密钥：已将其隐藏。你可以更改。"
          }
        }
      }
    },
    "hint_secret_sensitive" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ursprungs-App hat diesen Inhalt als vertraulich markiert: Er wird verborgen gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
