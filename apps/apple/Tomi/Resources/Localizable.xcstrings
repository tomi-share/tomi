      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Dein Tomi-Server löscht den Raum, dann wird alles auf diesem Mac gelöscht: Einträge, verborgene Inhalte, Dateien und Schlüssel. Niemand kann sie wiederherstellen."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Dein Tomi-Server löscht den Raum, dann wird alles auf diesem Telefon gelöscht: Einträge, verborgene Inhalte, Dateien und Schlüssel. Niemand kann sie wiederherstellen."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Your Tomi server erases the space, then this Mac erases everything it holds: items, hidden content, files and keys. No one will be able to recover them."
