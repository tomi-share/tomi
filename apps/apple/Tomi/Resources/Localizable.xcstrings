          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアイテムを読むにはアップデートが必要です。アイテムは保持され、Tomiのアップデート後に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 항목을 읽으려면 업데이트가 필요해요. 항목은 보관되며 Tomi를 업데이트하면 표시돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
