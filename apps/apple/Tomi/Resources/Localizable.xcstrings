          "stringUnit" : {
            "state" : "translated",
            "value" : "必要に応じて共有メニューを開き直してください。Tomiがピンのアイコン付きで先頭に表示されるはずです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필요하면 공유 메뉴를 다시 여세요. Tomi가 고정 표시와 함께 맨 앞에 나타나야 해요."
          }
        },
        "nl" : {
          "stringUnit" : {
