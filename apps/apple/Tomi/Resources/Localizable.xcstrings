    "ios_rotation_stalled_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein entferntes Gerät besitzt vielleicht noch den aktuellen Schlüssel deines Raums. Tomi versucht es automatisch erneut; öffne Tomi auf deinen anderen Geräten, um zu helfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A removed device may still hold the current key of your space. Tomi retries automatically; open Tomi on your other devices to help."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que un dispositivo quitado aún tenga la clave actual de tu espacio. Tomi lo vuelve a intentar automáticamente; abre Tomi en tus otros dispositivos para ayudar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un appareil retiré peut encore détenir la clé actuelle de ton espace. Tomi réessaie automatiquement ; ouvre Tomi sur tes autres appareils pour aider."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हो सकता है कि हटाए गए डिवाइस के पास अब भी आपके स्पेस की मौजूदा कुंजी हो। Tomi अपने-आप फिर से कोशिश करता है; मदद के लिए अपने दूसरे डिवाइस पर Tomi खोलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perangkat yang dikeluarkan mungkin masih menyimpan kunci ruang Anda saat ini. Tomi mencoba lagi secara otomatis; buka Tomi di perangkat Anda yang lain untuk membantu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dispositivo rimosso potrebbe avere ancora la chiave attuale del tuo spazio. Tomi riprova automaticamente; apri Tomi sugli altri tuoi dispositivi per aiutare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除外したデバイスが、スペースの現在のキーをまだ保持している可能性があります。Tomiは自動的に再試行します。ほかのデバイスでTomiを開くと、完了しやすくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제거된 기기가 아직 내 공간의 현재 키를 가지고 있을 수 있어요. Tomi가 자동으로 다시 시도해요. 다른 기기에서 Tomi를 열면 도움이 돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een verwijderd apparaat heeft misschien nog de huidige sleutel van je ruimte. Tomi probeert het automatisch opnieuw; open Tomi op je andere apparaten om te helpen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykluczone urządzenie może nadal mieć aktualny klucz twojej przestrzeni. Tomi ponawia próbę automatycznie; otwórz Tomi na swoich pozostałych urządzeniach, aby pomóc."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um dispositivo removido ainda pode ter a chave atual do seu espaço. O Tomi tenta novamente de forma automática; abra o Tomi nos seus outros dispositivos para ajudar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У исключённого устройства всё ещё может быть текущий ключ вашего пространства. Tomi повторяет попытку автоматически; откройте Tomi на других ваших устройствах, чтобы помочь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çıkarılan bir cihaz alanınızın geçerli anahtarını hâlâ tutuyor olabilir. Tomi otomatik olarak yeniden deniyor; yardımcı olmak için Tomi’yi diğer cihazlarınızda açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已移除的设备可能仍持有你空间的当前密钥。Tomi 会自动重试；在你的其他设备上打开 Tomi 会有所帮助。"
          }
        }
      }
    },
