    "ios_capture_cover" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verborgener Inhalt wird angezeigt, während der Bildschirm dieses iPhone geteilt oder aufgezeichnet wird. Tomi verdeckt ihn, damit er nicht in der Kopie erscheint."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hidden content is shown while the screen of this iPhone is being shared or recorded. Tomi covers it so that it does not appear in the copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se está mostrando contenido oculto mientras se comparte o se graba la pantalla de este iPhone. Tomi lo cubre para que no aparezca en la copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un contenu masqué est affiché alors que l’écran de cet iPhone est partagé ou enregistré. Tomi le cache pour qu’il n’apparaisse pas dans la copie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस iPhone की स्क्रीन शेयर या रिकॉर्ड होते समय छिपा हुआ कॉन्टेंट दिख रहा है। Tomi उसे ढक देता है ताकि वह कॉपी में न दिखे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konten tersembunyi sedang ditampilkan saat layar iPhone ini dibagikan atau direkam. Tomi menutupinya agar tidak muncul di salinannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I contenuti nascosti sono mostrati mentre lo schermo di questo iPhone viene condiviso o registrato. Tomi li copre perché non compaiano nella copia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneの画面が共有または収録されている間は、非表示のコンテンツが表示されます。コピーに写らないよう、Tomiがコンテンツを覆っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone의 화면이 공유되거나 녹화되는 동안 숨김 콘텐츠가 표시되어 있어요. 복사본에 나타나지 않도록 Tomi가 가려요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verborgen inhoud wordt getoond terwijl het scherm van deze iPhone wordt gedeeld of opgenomen. Tomi bedekt de inhoud zodat hij niet in de kopie verschijnt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukryta treść jest pokazywana, gdy ekran tego iPhone’a jest udostępniany lub nagrywany. Tomi ją zakrywa, aby nie pojawiła się w kopii."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
