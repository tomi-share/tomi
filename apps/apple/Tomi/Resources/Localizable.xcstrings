            }
          }
        },
        "it" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tomi non riesce ad aprire i suoi dati su questo Mac. I dati dell’app potrebbero essere stati cancellati o danneggiati (Mac ripristinato, spazio di archiviazione dell’app svuotato), oppure la chiave che li protegge non è più utilizzabile. Gli altri tuoi dispositivi non sono coinvolti."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tomi non riesce ad aprire i suoi dati su questo telefono. I dati dell’app potrebbero essere stati cancellati o danneggiati (telefono ripristinato, spazio di archiviazione dell’app svuotato), oppure la chiave che li protegge non è più utilizzabile. Gli altri tuoi dispositivi non sono coinvolti."
                }
