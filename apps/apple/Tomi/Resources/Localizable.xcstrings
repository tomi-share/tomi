    "leave_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device will leave your space. Everything it holds will be erased: items, hidden content, files and keys, including what has not been sent yet. Your other devices keep their copy. To come back, you will have to add this device again from another device."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil va quitter ton espace. Tout ce qu’il contient sera effacé : éléments, secrets, fichiers et clés, y compris ce qui n’est pas encore envoyé. Tes autres appareils gardent leur copie. Pour revenir, il faudra ajouter de nouveau cet appareil depuis un autre appareil."
          }
        }
      }
    },
