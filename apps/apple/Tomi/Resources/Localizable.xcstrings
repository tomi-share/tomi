              }
            }
          }
        },
        "pt" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Não é possível usar o Touch ID nem a senha deste Mac: o conteúdo oculto não pode ser mostrado, copiado nem compartilhado."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Configure um bloqueio de tela ou a biometria para mostrar, copiar ou compartilhar conteúdo oculto."
