    "space_not_found_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Dein Tomi-Server findet deinen Raum nicht mehr. Wenn er zurückgesetzt wurde, kannst du diesen Mac leeren; andernfalls prüfe zuerst deinen Server. Auf diesem Mac wurde nichts gelöscht."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Dein Tomi-Server findet deinen Raum nicht mehr. Wenn er zurückgesetzt wurde, kannst du dieses Telefon leeren; andernfalls prüfe zuerst deinen Server. Auf diesem Telefon wurde nichts gelöscht."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Your Tomi server can no longer find your space. If it has been reset, you can erase this Mac; otherwise, check your server first. Nothing has been erased on this Mac."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Your Tomi server can no longer find your space. If it has been reset, you can erase this phone; otherwise, check your server first. Nothing has been erased on this phone."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tu servidor Tomi ya no encuentra tu espacio. Si se restableció, puedes borrar este Mac; si no, revisa primero tu servidor. No se borró nada en este Mac."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tu servidor Tomi ya no encuentra tu espacio. Si se restableció, puedes borrar este teléfono; si no, revisa primero tu servidor. No se borró nada en este teléfono."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ton serveur Tomi ne trouve plus ton espace. S’il a été réinitialisé, tu peux effacer ce Mac ; sinon, vérifie d’abord ton serveur. Rien n’a été effacé sur ce Mac."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ton serveur Tomi ne trouve plus ton espace. S’il a été réinitialisé, tu peux effacer ce téléphone ; sinon, vérifie d’abord ton serveur. Rien n’a été effacé sur ce téléphone."
                }
              }
            }
          }
        },
        "hi" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "आपके Tomi सर्वर को अब आपका स्पेस नहीं मिल रहा है। अगर उसे रीसेट किया गया है, तो आप इस Mac से सब मिटा सकते हैं; नहीं तो पहले अपना सर्वर जाँचें। इस Mac पर कुछ भी मिटाया नहीं गया है।"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "आपके Tomi सर्वर को अब आपका स्पेस नहीं मिल रहा है। अगर उसे रीसेट किया गया है, तो आप इस फ़ोन से सब मिटा सकते हैं; नहीं तो पहले अपना सर्वर जाँचें। इस फ़ोन पर कुछ भी मिटाया नहीं गया है।"
                }
              }
            }
          }
        },
        "id" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Server Tomi Anda tidak dapat lagi menemukan ruang Anda. Jika server telah disetel ulang, Anda dapat membersihkan Mac ini; jika tidak, periksa server Anda terlebih dahulu. Tidak ada yang dihapus di Mac ini."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Server Tomi Anda tidak dapat lagi menemukan ruang Anda. Jika server telah disetel ulang, Anda dapat membersihkan ponsel ini; jika tidak, periksa server Anda terlebih dahulu. Tidak ada yang dihapus di ponsel ini."
                }
              }
            }
          }
        },
        "it" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Il tuo server Tomi non trova più il tuo spazio. Se è stato reimpostato, puoi cancellare questo Mac; altrimenti, controlla prima il tuo server. Su questo Mac non è stato cancellato nulla."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Il tuo server Tomi non trova più il tuo spazio. Se è stato reimpostato, puoi cancellare questo telefono; altrimenti, controlla prima il tuo server. Su questo telefono non è stato cancellato nulla."
                }
              }
            }
          }
        },
        "ja" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tomiサーバーがスペースを見つけられなくなりました。サーバーがリセットされた場合は、このMacを消去できます。そうでない場合は、まずサーバーを確認してください。このMacでは何も消去されていません。"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tomiサーバーがスペースを見つけられなくなりました。サーバーがリセットされた場合は、このスマートフォンを消去できます。そうでない場合は、まずサーバーを確認してください。このスマートフォンでは何も消去されていません。"
                }
              }
            }
          }
        },
        "ko" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tomi 서버가 더 이상 내 공간을 찾을 수 없어요. 서버가 초기화되었다면 이 Mac을 지울 수 있어요. 그렇지 않다면 먼저 서버를 확인하세요. 이 Mac에서는 아무것도 지워지지 않았어요."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tomi 서버가 더 이상 내 공간을 찾을 수 없어요. 서버가 초기화되었다면 이 휴대전화를 지울 수 있어요. 그렇지 않다면 먼저 서버를 확인하세요. 이 휴대전화에서는 아무것도 지워지지 않았어요."
                }
              }
            }
          }
        },
        "nl" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Je Tomi-server kan je ruimte niet meer vinden. Als de server is gereset, kun je deze Mac wissen; controleer anders eerst je server. Er is niets gewist op deze Mac."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Je Tomi-server kan je ruimte niet meer vinden. Als de server is gereset, kun je deze telefoon wissen; controleer anders eerst je server. Er is niets gewist op deze telefoon."
                }
              }
            }
          }
