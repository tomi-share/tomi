    "erase_waiting" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Anfrage an deinen Server läuft noch. Tomi wartet, bis sie abgeschlossen ist, bevor geleert wird. Es wurde nichts gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A request to your server is still in progress. Tomi is waiting for it to finish before erasing. Nothing has been erased."
