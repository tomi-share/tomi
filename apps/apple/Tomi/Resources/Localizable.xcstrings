    "invite_notice_auth_denied" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestätigung abgebrochen: Es wurde nichts hinzugefügt. Tippe erneut auf „Dieses Gerät hinzufügen“, wenn du bereit bist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmation cancelled: nothing was added. Tap “Add this device” again when you are ready."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmación cancelada: no se agregó nada. Vuelve a tocar “Agregar este dispositivo” cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmation annulée : rien n’a été ajouté. Appuie de nouveau sur « Ajouter cet appareil » quand tu es prêt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुष्टि रद्द की गई: कुछ भी नहीं जोड़ा गया। तैयार होने पर “यह डिवाइस जोड़ें” पर फिर से टैप करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfirmasi dibatalkan: tidak ada yang ditambahkan. Ketuk “Tambahkan perangkat ini” lagi saat Anda siap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conferma annullata: non è stato aggiunto nulla. Tocca di nuovo “Aggiungi questo dispositivo” quando sei pronto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認がキャンセルされたため、何も追加されていません。準備ができたら、もう一度「このデバイスを追加」をタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확인이 취소되어 아무것도 추가되지 않았어요. 준비되면 ‘이 기기 추가’를 다시 탭하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevestiging geannuleerd: er is niets toegevoegd. Tik opnieuw op “Dit apparaat toevoegen” wanneer je klaar bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anulowano potwierdzenie: nic nie zostało dodane. Dotknij ponownie „Dodaj to urządzenie”, kiedy zechcesz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmação cancelada: nada foi adicionado. Toque em “Adicionar este dispositivo” de novo quando estiver pronto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подтверждение отменено: ничего не добавлено. Когда будете готовы, снова нажмите «Добавить это устройство»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onay iptal edildi: hiçbir şey eklenmedi. Hazır olduğunuzda “Bu cihazı ekle” düğmesine yeniden dokunun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已取消确认：未添加任何设备。准备好后，请再次点按“添加这台设备”。"
          }
        }
      }
