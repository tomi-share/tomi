          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Après lecture » : effacé partout dès la première ouverture."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“पढ़ने के बाद”: पहली बार खोलते ही हर जगह से मिटा दिया जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
