            "value" : "Öffne das Teilen-Menü bei Bedarf erneut. Tomi sollte ganz vorne erscheinen, mit einer Stecknadel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reopen the share menu if needed. Tomi should appear first, with a pin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a abrir el menú Compartir si hace falta. Tomi debería aparecer en primer lugar, fijado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rouvre le menu Partager si besoin. Tomi doit apparaître en premier, avec une épingle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़रूरत हो तो शेयर मेन्यू फिर से खोलें। Tomi पिन के साथ सबसे पहले दिखना चाहिए।"
          }
        },
        "id" : {
          "stringUnit" : {
