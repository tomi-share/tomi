    "erase_expired" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Antwort deines Servers ist nicht mehr gültig: Sie ist zu alt, oder dein Server hat inzwischen anders geantwortet. Es wurde nichts gelöscht. Versuche es gleich erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The answer from your server is no longer valid: it is too old, or your server has answered differently since. Nothing has been erased. Try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La respuesta de tu servidor ya no es válida: es demasiado antigua o tu servidor respondió de otra forma desde entonces. No se borró nada. Vuelve a intentarlo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réponse de ton serveur n’est plus valable : elle date de trop longtemps, ou ton serveur a répondu autrement entre-temps. Rien n’a été effacé. Réessaie dans un instant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके सर्वर का जवाब अब मान्य नहीं है: वह बहुत पुराना है, या उसके बाद आपके सर्वर ने अलग जवाब दिया है। कुछ भी मिटाया नहीं गया है। थोड़ी देर में फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawaban dari server Anda tidak berlaku lagi: sudah terlalu lama, atau server Anda telah memberi jawaban berbeda sejak itu. Tidak ada yang dihapus. Coba lagi sebentar lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La risposta del tuo server non è più valida: è troppo vecchia, o nel frattempo il tuo server ha risposto diversamente. Non è stato cancellato nulla. Riprova tra un momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーからの応答は無効になりました。古すぎるか、その後サーバーが別の応答をしています。何も消去されていません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버의 응답이 더 이상 유효하지 않아요. 너무 오래되었거나 그 후 서버가 다르게 응답했어요. 아무것도 지워지지 않았어요. 잠시 후 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het antwoord van je server is niet meer geldig: het is te oud, of je server heeft sindsdien anders geantwoord. Er is niets gewist. Probeer het zo opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpowiedź twojego serwera nie jest już ważna: jest za stara albo serwer od tego czasu odpowiedział inaczej. Nic nie zostało wymazane. Spróbuj ponownie za chwilę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A resposta do seu servidor não é mais válida: ela é antiga demais, ou seu servidor respondeu de outra forma desde então. Nada foi apagado. Tente novamente em instantes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ответ вашего сервера больше не действителен: он слишком старый или сервер с тех пор ответил иначе. Ничего не стёрто. Повторите попытку чуть позже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucunuzun yanıtı artık geçerli değil: çok eski veya sunucunuz o zamandan beri farklı yanıt verdi. Hiçbir şey silinmedi. Birazdan tekrar deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的服务器的回复已失效：它太旧了，或者你的服务器之后给出了不同的回复。未抹掉任何内容。请稍后重试。"
          }
        }
      }
    },
