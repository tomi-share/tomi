            "state" : "translated",
            "value" : "此条目暂时无法读取。它会被保留：同步或更新后可能就能读取。"
          }
        }
      }
    },
    "unreadable_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tomi kann seine Daten auf diesem Mac nicht öffnen. Die Daten der App wurden vielleicht gelöscht oder beschädigt (Mac wiederhergestellt, App-Speicher geleert), oder der Schlüssel, der sie schützt, ist nicht mehr nutzbar. Deine anderen Geräte sind nicht betroffen."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tomi kann seine Daten auf diesem Telefon nicht öffnen. Die Daten der App wurden vielleicht gelöscht oder beschädigt (Telefon wiederhergestellt, App-Speicher geleert), oder der Schlüssel, der sie schützt, ist nicht mehr nutzbar. Deine anderen Geräte sind nicht betroffen."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tomi can’t open its data on this Mac. The app’s data may have been erased or damaged (Mac restored, app storage cleared), or the key that protects it can no longer be used. Your other devices are not affected."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tomi can’t open its data on this phone. The app’s data may have been erased or damaged (phone restored, app storage cleared), or the key that protects it can no longer be used. Your other devices are not affected."
                }
              }
            }
