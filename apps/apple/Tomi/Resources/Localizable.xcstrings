        },
        "es" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tomi no puede abrir sus datos en este Mac. Es posible que los datos de la app se hayan borrado o dañado (Mac restaurado, almacenamiento de la app borrado) o que la clave que los protege ya no se pueda usar. Tus otros dispositivos no se ven afectados."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tomi no puede abrir sus datos en este teléfono. Es posible que los datos de la app se hayan borrado o dañado (teléfono restaurado, almacenamiento de la app borrado) o que la clave que los protege ya no se pueda usar. Tus otros dispositivos no se ven afectados."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tomi n’arrive pas à ouvrir ses données sur ce Mac. Les données de l’app ont peut-être été effacées ou abîmées (Mac restauré, stockage de l’app nettoyé), ou la clé qui les protège n’est plus utilisable. Tes autres appareils ne sont pas touchés."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tomi n’arrive pas à ouvrir ses données sur ce téléphone. Les données de l’app ont peut-être été effacées ou abîmées (téléphone restauré, stockage de l’app nettoyé), ou la clé qui les protège n’est plus utilisable. Tes autres appareils ne sont pas touchés."
                }
              }
            }
          }
        },
        "hi" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tomi इस Mac पर अपना डेटा नहीं खोल पा रहा है। हो सकता है कि ऐप का डेटा मिट गया हो या खराब हो गया हो (Mac रीस्टोर किया गया, ऐप स्टोरेज साफ़ किया गया), या उसे सुरक्षित रखने वाली कुंजी अब इस्तेमाल न की जा सके। आपके दूसरे डिवाइस पर इसका कोई असर नहीं है।"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tomi इस फ़ोन पर अपना डेटा नहीं खोल पा रहा है। हो सकता है कि ऐप का डेटा मिट गया हो या खराब हो गया हो (फ़ोन रीस्टोर किया गया, ऐप स्टोरेज साफ़ किया गया), या उसे सुरक्षित रखने वाली कुंजी अब इस्तेमाल न की जा सके। आपके दूसरे डिवाइस पर इसका कोई असर नहीं है।"
                }
