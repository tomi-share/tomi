    "devices_inactive_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit %1$@ inaktiv. Nutzt du es nicht mehr? Entferne es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inactive for %1$@. No longer using it? Remove it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inactivo desde hace %1$@. ¿Ya no lo usas? Quítalo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inactif depuis %1$@. Tu ne l’utilises plus ? Retire-le."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ से निष्क्रिय। अब इसका इस्तेमाल नहीं करते? इसे हटाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak aktif selama %1$@. Sudah tidak digunakan? Keluarkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inattivo da %1$@. Non lo usi più? Rimuovilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@使用されていません。もう使わない場合は除外してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 동안 비활성 상태예요. 더 이상 사용하지 않나요? 제거하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ inactief. Gebruik je het niet meer? Haal het uit je ruimte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieaktywne od %1$@. Już go nie używasz? Wyklucz je."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inativo há %1$@. Não usa mais? Remova-o."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неактивно уже %1$@. Больше не пользуетесь им? Исключите его."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ boyunca etkin değil. Artık kullanmıyor musunuz? Çıkarın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已有 %1$@未活动。不再使用它了？请将其移除。"
          }
        }
      }
    },
