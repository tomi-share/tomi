        "tr" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tomi bu Mac’teki verilerini açamıyor. Uygulamanın verileri silinmiş veya bozulmuş olabilir (Mac geri yüklendi, uygulama verileri temizlendi) ya da verileri koruyan anahtar artık kullanılamıyor. Diğer cihazlarınız etkilenmez."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tomi bu telefondaki verilerini açamıyor. Uygulamanın verileri silinmiş veya bozulmuş olabilir (telefon geri yüklendi, uygulama verileri temizlendi) ya da verileri koruyan anahtar artık kullanılamıyor. Diğer cihazlarınız etkilenmez."
                }
