        "pt" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "O Tomi não consegue abrir os próprios dados neste Mac. Os dados do app podem ter sido apagados ou danificados (Mac restaurado, armazenamento do app limpo), ou a chave que os protege não pode mais ser usada. Seus outros dispositivos não são afetados."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "O Tomi não consegue abrir os próprios dados neste celular. Os dados do app podem ter sido apagados ou danificados (celular restaurado, armazenamento do app limpo), ou a chave que os protege não pode mais ser usada. Seus outros dispositivos não são afetados."
                }
              }
            }
          }
        },
        "ru" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tomi не может открыть свои данные на этом Mac. Данные приложения могли быть стёрты или повреждены (восстановление Mac, очистка хранилища приложения), либо ключ, который их защищает, больше нельзя использовать. Другие ваши устройства не затронуты."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tomi не может открыть свои данные на этом телефоне. Данные приложения могли быть стёрты или повреждены (восстановление телефона, очистка хранилища приложения), либо ключ, который их защищает, больше нельзя использовать. Другие ваши устройства не затронуты."
                }
