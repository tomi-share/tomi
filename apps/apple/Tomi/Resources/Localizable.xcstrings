    "rotation_stalled_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein entferntes Gerät besitzt vielleicht noch den aktuellen Schlüssel deines Raums. Tomi versucht stündlich, ihn zu erneuern. Es hilft, Tomi auf deinen anderen Geräten zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A removed device may still hold the current key of your space. Tomi retries renewing it every hour. Opening Tomi on your other devices helps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que un dispositivo quitado aún tenga la clave actual de tu espacio. Tomi vuelve a intentar renovarla cada hora. Abrir Tomi en tus otros dispositivos ayuda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un appareil retiré peut encore détenir la clé actuelle de ton espace. Tomi réessaie de la renouveler toutes les heures. Ouvrir Tomi sur tes autres appareils aide à y arriver."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हो सकता है कि हटाए गए डिवाइस के पास अब भी आपके स्पेस की मौजूदा कुंजी हो। Tomi हर घंटे इसे बदलने की फिर से कोशिश करता है। अपने दूसरे डिवाइस पर Tomi खोलने से मदद मिलती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perangkat yang dikeluarkan mungkin masih menyimpan kunci ruang Anda saat ini. Tomi mencoba memperbaruinya lagi setiap jam. Membuka Tomi di perangkat Anda yang lain dapat membantu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dispositivo rimosso potrebbe avere ancora la chiave attuale del tuo spazio. Tomi riprova a rinnovarla ogni ora. Aprire Tomi sugli altri tuoi dispositivi aiuta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除外したデバイスが、スペースの現在のキーをまだ保持している可能性があります。Tomiは1時間ごとにキーの更新を再試行します。ほかのデバイスでTomiを開くと、完了しやすくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제거된 기기가 아직 내 공간의 현재 키를 가지고 있을 수 있어요. Tomi가 1시간마다 키 갱신을 다시 시도해요. 다른 기기에서 Tomi를 열면 도움이 돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een verwijderd apparaat heeft misschien nog de huidige sleutel van je ruimte. Tomi probeert die elk uur opnieuw te vernieuwen. Tomi openen op je andere apparaten helpt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykluczone urządzenie może nadal mieć aktualny klucz twojej przestrzeni. Tomi co godzinę ponawia próbę jego odnowienia. Pomaga otwarcie Tomi na twoich pozostałych urządzeniach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um dispositivo removido ainda pode ter a chave atual do seu espaço. O Tomi tenta renová-la novamente a cada hora. Abrir o Tomi nos seus outros dispositivos ajuda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У исключённого устройства всё ещё может быть текущий ключ вашего пространства. Tomi пытается обновить его каждый час. Поможет, если открыть Tomi на других ваших устройствах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çıkarılan bir cihaz alanınızın geçerli anahtarını hâlâ tutuyor olabilir. Tomi anahtarı yenilemeyi her saat yeniden deniyor. Tomi’yi diğer cihazlarınızda açmak yardımcı olur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已移除的设备可能仍持有你空间的当前密钥。Tomi 每小时会重试更新密钥。在你的其他设备上打开 Tomi 会有所帮助。"
          }
        }
      }
    },
