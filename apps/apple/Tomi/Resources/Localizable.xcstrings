    "dialog_delete_everywhere_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Eintrag wird von allen deinen Geräten und von deinem Tomi-Server gelöscht. Offline-Geräte löschen ihn, sobald sie wieder verbunden sind. Diese Aktion ist endgültig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The item will be erased from all your devices and from your Tomi server. Offline devices will erase it when they reconnect. This action is permanent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El elemento se borrará de todos tus dispositivos y de tu servidor Tomi. Los dispositivos sin conexión lo borrarán al volver a conectarse. Esta acción es permanente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’élément sera effacé sur tous tes appareils et sur ton serveur Tomi. Les appareils hors ligne l’effaceront à leur reconnexion. Cette action est définitive."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह आइटम आपके सभी डिवाइस और आपके Tomi सर्वर से मिटा दिया जाएगा। ऑफ़लाइन डिवाइस फिर से कनेक्ट होने पर इसे मिटा देंगे। यह कार्रवाई स्थायी है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Item ini akan dihapus dari semua perangkat Anda dan dari server Tomi Anda. Perangkat yang sedang offline akan menghapusnya saat tersambung kembali. Tindakan ini permanen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’elemento sarà cancellato da tutti i tuoi dispositivi e dal tuo server Tomi. I dispositivi offline lo cancelleranno quando si riconnetteranno. Questa azione è definitiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアイテムはすべてのデバイスとTomiサーバーから消去されます。オフラインのデバイスでは、再接続時に消去されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목이 모든 기기와 Tomi 서버에서 지워져요. 오프라인 기기는 다시 연결될 때 지워요. 이 작업은 영구적이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het item wordt gewist van al je apparaten en van je Tomi-server. Apparaten die offline zijn, wissen het zodra ze weer verbinding hebben. Deze actie is definitief."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Element zostanie wymazany ze wszystkich twoich urządzeń i z twojego serwera Tomi. Urządzenia offline wymażą go po ponownym połączeniu. Tego działania nie można cofnąć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O item será apagado de todos os seus dispositivos e do seu servidor Tomi. Os dispositivos off-line vão apagá-lo quando se reconectarem. Esta ação é permanente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Элемент будет стёрт со всех ваших устройств и с вашего сервера Tomi. Устройства не в сети сотрут его, когда снова подключатся. Это действие необратимо."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğe tüm cihazlarınızdan ve Tomi sunucunuzdan silinecek. Çevrimdışı cihazlar yeniden bağlandıklarında onu silecek. Bu işlem kalıcıdır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该条目将从你的所有设备和你的 Tomi 服务器上删除。离线的设备会在重新连接后删除它。此操作是永久性的。"
          }
        }
      }
    },
    "dialog_delete_everywhere_secret" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser verborgene Inhalt wird von allen deinen Geräten und von deinem Tomi-Server gelöscht. Ein Gerät, das ihn bereits angezeigt hat, hat möglicherweise eine Kopie behalten. Diese Aktion ist endgültig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This hidden content will be erased from all your devices and from your Tomi server. A device that has already shown it may have kept a copy. This action is permanent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este contenido oculto se borrará de todos tus dispositivos y de tu servidor Tomi. Un dispositivo que ya lo haya mostrado podría haber guardado una copia. Esta acción es permanente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce contenu masqué sera effacé sur tous tes appareils et sur ton serveur Tomi. Un appareil qui l’a déjà affiché a pu en garder une copie. Cette action est définitive."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह छिपा हुआ कॉन्टेंट आपके सभी डिवाइस और आपके Tomi सर्वर से मिटा दिया जाएगा। हो सकता है कि जिस डिवाइस पर इसे पहले ही दिखाया जा चुका है, उसने इसकी कॉपी रख ली हो। यह कार्रवाई स्थायी है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konten tersembunyi ini akan dihapus dari semua perangkat Anda dan dari server Tomi Anda. Perangkat yang sudah menampilkannya mungkin telah menyimpan salinannya. Tindakan ini permanen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo contenuto nascosto sarà cancellato da tutti i tuoi dispositivi e dal tuo server Tomi. Un dispositivo che l’ha già mostrato potrebbe averne conservato una copia. Questa azione è definitiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この非表示のコンテンツはすべてのデバイスとTomiサーバーから消去されます。すでに表示したデバイスにはコピーが残っている可能性があります。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 숨김 콘텐츠가 모든 기기와 Tomi 서버에서 지워져요. 이미 이 콘텐츠를 표시한 기기에는 사본이 남아 있을 수 있어요. 이 작업은 영구적이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze verborgen inhoud wordt gewist van al je apparaten en van je Tomi-server. Een apparaat dat de inhoud al heeft getoond, kan een kopie hebben bewaard. Deze actie is definitief."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta ukryta treść zostanie wymazana ze wszystkich twoich urządzeń i z twojego serwera Tomi. Urządzenie, które już ją pokazało, mogło zachować kopię. Tego działania nie można cofnąć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este conteúdo oculto será apagado de todos os seus dispositivos e do seu servidor Tomi. Um dispositivo que já o mostrou pode ter guardado uma cópia. Esta ação é permanente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это скрытое содержимое будет стёрто со всех ваших устройств и с вашего сервера Tomi. Устройство, на котором его уже показывали, могло сохранить копию. Это действие необратимо."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu gizli içerik tüm cihazlarınızdan ve Tomi sunucunuzdan silinecek. Onu daha önce göstermiş bir cihaz bir kopyasını saklamış olabilir. Bu işlem kalıcıdır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这项隐藏内容将从你的所有设备和你的 Tomi 服务器上删除。已经显示过它的设备可能保留了副本。此操作是永久性的。"
          }
        }
      }
    },
