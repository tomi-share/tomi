    "devices_revoke_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Dieses Gerät wird aus dem Raum entfernt und der Schlüssel des Raums wird erneuert. Es kann danach keine neuen Einträge mehr lesen. Du wirst nach Touch ID oder dem Passwort dieses Mac gefragt."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Dieses Gerät wird aus dem Raum entfernt und der Schlüssel des Raums wird erneuert. Es kann danach keine neuen Einträge mehr lesen. Du wirst nach deinem Fingerabdruck, deinem Gesicht oder dem Code deiner Displaysperre gefragt."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This device will be removed from the space and the space key will be renewed. It will no longer be able to read new items. You will be asked for Touch ID or this Mac’s password."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
