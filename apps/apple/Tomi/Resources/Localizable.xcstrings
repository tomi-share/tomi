    "welcome_intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sende dir Links, Notizen und Passwörter von einem Gerät zum anderen, Ende-zu-Ende-verschlüsselt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send yourself links, notes and passwords from one device to another, end-to-end encrypted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envíate enlaces, notas y contraseñas de un dispositivo a otro, con cifrado de extremo a extremo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie-toi des liens, des notes et des mots de passe d’un appareil à l’autre, chiffrés de bout en bout."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक डिवाइस से दूसरे डिवाइस पर खुद को लिंक, नोट और पासवर्ड भेजें, एंड-टू-एंड एन्क्रिप्शन के साथ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirim tautan, catatan, dan kata sandi ke diri sendiri dari satu perangkat ke perangkat lain, dengan enkripsi end-to-end."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mandati link, note e password da un dispositivo all’altro, con crittografia end-to-end."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンク、メモ、パスワードをデバイスからデバイスへ、エンドツーエンドで暗号化して自分に送れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "링크, 메모, 비밀번호를 내 기기끼리 종단간 암호화로 주고받으세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuur jezelf links, notities en wachtwoorden van het ene apparaat naar het andere, end-to-end versleuteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesyłaj sobie linki, notatki i hasła z jednego urządzenia na drugie, z szyfrowaniem end-to-end."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie para você mesmo links, notas e senhas de um dispositivo para outro, com criptografia de ponta a ponta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляйте себе ссылки, заметки и пароли с одного устройства на другое со сквозным шифрованием."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantıları, notları ve parolaları uçtan uca şifrelenmiş olarak bir cihazınızdan diğerine gönderin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在设备之间给自己发送链接、笔记和密码，全程端到端加密。"
          }
        }
      }
    },
    "welcome_join_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist Tomi schon auf einem anderen Gerät? Lass es geöffnet und halte es in Reichweite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is Tomi already on another device? Keep it open and within reach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tomi ya está en otro dispositivo? Mantenlo abierto y a mano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomi est déjà sur un autre appareil ? Garde-le ouvert à portée de main."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या Tomi पहले से किसी दूसरे डिवाइस पर है? उसे खुला और पास रखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomi sudah ada di perangkat lain? Biarkan tetap terbuka dan dalam jangkauan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomi è già su un altro dispositivo? Tienilo aperto e a portata di mano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのデバイスですでにTomiを使っていますか？そのデバイスでTomiを開いたまま、手元に置いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 기기에 이미 Tomi가 있나요? 그 기기를 열어 두고 가까이 두세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staat Tomi al op een ander apparaat? Houd het open en binnen handbereik."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomi jest już na innym urządzeniu? Miej je otwarte i pod ręką."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Tomi já está em outro dispositivo? Deixe-o aberto e por perto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomi уже есть на другом устройстве? Откройте его и держите рядом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomi başka bir cihazınızda zaten var mı? O cihazı açık ve yakınınızda tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一台设备上已经有 Tomi 了？请让它保持打开并放在手边。"
          }
        }
      }
    },
