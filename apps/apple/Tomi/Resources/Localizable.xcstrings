    "create_error_qr" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser QR-Code ist weder ein Installationsschlüssel noch ein Erstellungslink. Scanne den deines Tomi-Servers oder gib den Schlüssel ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This QR code is neither an installation key nor a creation link. Scan the one from your Tomi server or enter the key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este código QR no es una clave de instalación ni un enlace de creación. Escanea el de tu servidor Tomi o escribe la clave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce QR code n’est ni une clé d’installation ni un lien de création. Scanne celui de ton serveur Tomi ou saisis la clé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह QR कोड न तो इंस्टॉलेशन कुंजी है, न ही स्पेस बनाने का लिंक। अपने Tomi सर्वर वाला QR कोड स्कैन करें या कुंजी डालें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kode QR ini bukan kunci instalasi maupun tautan pembuatan. Pindai kode dari server Tomi Anda atau masukkan kuncinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo codice QR non è né una chiave di installazione né un link di creazione. Scansiona quello del tuo server Tomi o inserisci la chiave."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このQRコードはインストールキーでも作成リンクでもありません。TomiサーバーのQRコードをスキャンするか、キーを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
