<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE): only what cannot be a build setting. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>eu.shaffe.tomi</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tomi-share</string>
			</array>
		</dict>
	</array>
	<!-- A menu bar app: no Dock icon until the full window opens (MacSurfaces). -->
	<key>LSUIElement</key>
	<true/>
	<!-- "Send with Tomi" in the Services menu (TomiMac/MacServices.swift): a selected text, selected files. The title is
	     English here (the fallback); the other languages are in TomiMac/InfoPlist.xcstrings, under the same words. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Send with Tomi</string>
			</dict>
			<key>NSMessage</key>
			<string>sendWithTomi</string>
			<key>NSPortName</key>
			<string>Tomi</string>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
				<string>NSStringPboardType</string>
				<string>public.url</string>
				<string>public.file-url</string>
				<string>NSFilenamesPboardType</string>
			</array>
		</dict>
	</array>
	<!-- The group shared with the share extension (TomiKit `AppGroup.identifier`). -->
	<key>TomiAppGroup</key>
	<string>$(TeamIdentifierPrefix)eu.shaffe.tomi</string>
	<key>TomiRelayURL</key>
	<string>$(TOMI_RELAY_URL)</string>
</dict>
</plist>
