#include "Base.xcconfig"
// Debug runs on the same core as every other build (the unified core), with the demo entered from the pairing screen.
// Its relay is the one of Config/Local.xcconfig when there is one, else the relay comes from the pairing. For the
// developer only, as launch arguments:
//   -TomiStartInDemo YES            enters the demo of that core at launch (a device that is in no space);
//   -TomiIsolatedDemo YES           opens the isolated demo core instead (no network, nothing of the space of
//                                   this device): to look at the app on a device that is in a real space;
//   -TomiRelayURL http://localhost:8080   a local relay (`just dev-relay`); the core accepts `http://localhost`
//                                   only when it is itself a debug build (`just apple-core --debug`).
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
