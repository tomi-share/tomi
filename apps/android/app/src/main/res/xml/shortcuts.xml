<?xml version="1.0" encoding="utf-8"?>
<!-- Direct Share: binds the dynamic shortcut published by SharingShortcut to ShareActivity. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="eu.shaffe.tomi.share.ShareActivity">
        <data android:mimeType="text/*" />
        <data android:mimeType="*/*" />
        <category android:name="eu.shaffe.tomi.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
