# Tomi — shared editor settings (https://editorconfig.org)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Rust: rustfmt is authoritative (default width 100)
[*.rs]
indent_size = 4
max_line_length = 100

[{Cargo.toml,Cargo.lock}]
indent_size = 4

# Kotlin: official style (ktlint / Android Studio)
[*.{kt,kts}]
indent_size = 4
max_line_length = 120

# TypeScript / JavaScript / web (Tauri frontend)
[*.{ts,tsx,js,jsx,mjs,cjs,json,html,css,svelte,vue}]
indent_size = 2

# YAML (CI)
[*.{yml,yaml}]
indent_size = 2

[*.toml]
indent_size = 4

# Markdown: two trailing spaces mean a forced line break; do not strip them
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Linux scripts and systemd units
[*.{sh,service,timer}]
indent_size = 4

[Caddyfile]
indent_style = tab
indent_size = 4

[justfile]
indent_size = 4

# Windows files interpreted by cmd.exe
[*.{bat,cmd}]
end_of_line = crlf
