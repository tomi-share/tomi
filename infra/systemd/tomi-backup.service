# Tomi — local backup of the data directory (see infra/backup.md).
# Triggered by tomi-backup.timer. Requires the `sqlite3` package.

[Unit]
Description=Tomi relay data backup
After=tomi-relay.service

[Service]
Type=oneshot
User=tomi
Group=tomi
EnvironmentFile=/etc/tomi/relay.env
ExecStart=/usr/local/sbin/tomi-backup
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tomi-backup
UMask=0077
Nice=10
IOSchedulingClass=idle

# --- Hardening ---
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# SQLite must be able to write the -shm file of the WAL database, even for a simple read.
ReadWritePaths=/var/lib/tomi /var/backups/tomi
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
