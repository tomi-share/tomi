# Tomi relay — example configuration.
# Copied by infra/install.sh to /etc/tomi/relay.env (root:tomi, mode 0640) ONLY if it does not
# already exist: an existing file is never overwritten.
#
# The relay keys (spec/api-v1.md §8.6) are overridden with variables named TOMI_RELAY_<KEY IN UPPERCASE>.
# This deployment does not use a TOML file: everything goes through this environment file.
#
# Format: KEY=value, one variable per line, WITHOUT quotes or `export`. This file is read by
# systemd (EnvironmentFile) and by /usr/local/sbin/tomi-admin (shell): keep values simple
# (no spaces, no `$`).
#
# NO secrets here. FCM credentials are a separate JSON file (see
# TOMI_RELAY_FCM_SERVICE_ACCOUNT_FILE), never a value in this file.

# LOCAL listen address of the relay (this is the default). Only the reverse proxy (Caddy,
# or nginx on a server already managed by another stack) talks to the outside world: never open this port
# in the cloud firewall / security group.
TOMI_RELAY_LISTEN=127.0.0.1:8080

# Data directory: routing.db, spaces/ (one SQLite database in WAL mode + blobs/ per space), public/
# (updates, assetlinks), admin.sock, relay.lock. The relay's default is /var/lib/tomi-relay;
# this deployment uses /var/lib/tomi. Must stay aligned with ReadWritePaths= in tomi-relay.service.
# There is no install-token file anymore: installation tokens are never written to disk
# (see infra/README.md step 7: first-start log, or `tomi-admin invite --new|--rotate`).
TOMI_RELAY_DATA_DIR=/var/lib/tomi

# "Unmounted volume" safeguard (spec/api-v1.md §8.6): set to true AFTER the first
# installation. The relay then refuses to start if the data directory contains neither
# routing.db nor spaces/ (unmounted volume, wrong path), instead of treating itself as new and answering
# "no space" to every device. infra/install.sh adds this line by itself after a successful first start.
# Leave it false (or commented out) for a very first installation.
#TOMI_RELAY_REQUIRE_EXISTING_DATA_DIR=true

# Public URL of the relay (no trailing slash). The relay has no real default value (its default
# is the example https://relay.example.org): it must be set. It is used for update URLs, as the origin
# of the web administration panel, and for the space creation link that this panel displays
# (<public_url>/create#<token>); the relay never derives it from a request's Host header.
TOMI_RELAY_PUBLIC_URL=https://relay.example.org

# --- Disk quotas ---
# The relay is multi-space (one person = one space). Layout inside the data directory:
# routing.db, spaces/<space_id>/relay.db and spaces/<space_id>/blobs/. Former layout (tomi.db
# and blobs/ at the root): migrated automatically at startup.
#
# TOTAL relay quota, all spaces combined, in bytes (default: 1 GiB). It protects the disk,
# which is small and shared with other services: choose it according to free space (see
# infra/backup.md for the peak of a backup: ~4 x this quota with 2 local archives).
TOMI_RELAY_MAX_RELAY_BYTES=1073741824
# PER-SPACE quota: no limit by default. Leave commented out, unless you want the same cap
# for all spaces. To set or remove the quota of a single space:
#   sudo tomi-admin quota --space <id> <octets|none>
#TOMI_RELAY_MAX_SPACE_BYTES=268435456

# --- Android notifications (FCM) ---
# Path to a Firebase service-account JSON file (HTTP v1). Leave commented out as long as
# Firebase is not configured: FCM is then disabled, the relay works, and only background
# Android notifications are missing (clients catch up at launch through the `seq` cursor).
# Place the file as root:tomi, mode 0640 (see infra/README.md).
#TOMI_RELAY_FCM_SERVICE_ACCOUNT_FILE=/etc/tomi/fcm-service-account.json

# --- iPhone notifications (APNs) ---
# The `.p8` signing key of the Apple developer account (same place and rights as the FCM file),
# its identifier and the team identifier (10 characters each). Leave commented out as long as
# the key does not exist: APNs is then disabled and iPhones only receive when the app is opened.
# See docs/push-apns.md.
#TOMI_RELAY_APNS_KEY_FILE=/etc/tomi/apns-key.p8
#TOMI_RELAY_APNS_KEY_ID=XXXXXXXXXX
#TOMI_RELAY_APNS_TEAM_ID=XXXXXXXXXX

# --- Logging ---
# The relay writes JSON to stdout (journald). `text` is easier to read by hand.
#TOMI_RELAY_LOG_FORMAT=json
# Level filter, if the relay reads RUST_LOG (tracing EnvFilter). Do not raise to debug/trace in
# production without re-reading the logging policy (spec/api-v1.md §9).
#RUST_LOG=info

# --- Backup (read by tomi-backup only; the relay ignores these variables) ---
# Where to write archives, and how many to keep locally (default 2: the disk peak of a
# backup is roughly the data + KEEP archives + 1 archive in progress, see infra/backup.md).
#TOMI_BACKUP_DIR=/var/backups/tomi
#TOMI_BACKUP_KEEP=2
# Free space to preserve once the archive is written, in bytes (default 2 GiB). Below that, the
# backup is refused (exit code 3, nothing is written) instead of filling the disk. The default is at
# least twice the relay's floor (min_free_disk_bytes = 1 GiB: below this amount of free disk space,
# it refuses uploads with `relay_full`): a backup must not cause uploads to be refused.
#TOMI_BACKUP_MIN_FREE_BYTES=2147483648
# Legacy layout only (a single tomi.db at the root): SQLite file to back up if
# auto-detection fails. Not needed with the multi-space layout.
#TOMI_BACKUP_DB=/var/lib/tomi/tomi.db
